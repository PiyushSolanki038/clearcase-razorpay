# Copy this to .env.local and fill in real values.
# Never commit .env.local

# Google Gemini API — https://ai.google.dev
# Free tier: ~15 req/min, ~1500 req/day. No card required.
GEMINI_API_KEY=

# Supabase Postgres — https://supabase.com/dashboard
# Get these from your Supabase project's Settings > Database and Settings > API
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
