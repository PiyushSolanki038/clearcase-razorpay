# Copy this to .env.local and fill in real values.
# Never commit .env.local

# Google Gemini API — https://ai.google.dev, model gemini-3.6-flash
# Free-tier limits vary by key/account — observed as low as 5 req/min, 20 req/day on
# one key. Check ai.dev/rate-limit for your actual limit; don't assume ~1500/day.
GEMINI_API_KEY=

# Supabase Postgres — https://supabase.com/dashboard
# Get these from your Supabase project's Settings > Database and Settings > API
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
